<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="
           http://maven.apache.org/POM/4.0.0
           http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.jlmc</groupId>
    <artifactId>settings-platform</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <!-- Java 21 configuration -->
    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <!-- Modules -->
    <modules>
        <!-- Common module that can be used in the server and client implementations -->
        <module>poc-tdk-settings-sdk</module>

        <!-- Server settings implementation -->
        <module>poc-tdk-settings-l1-l2-service</module>

        <!-- Client settings implementation, to be used in all apps that need to connect with the Server settings implementation -->
        <module>poc-tdk-settings-sdk-client</module>

        <!-- Spring Boot Starter to facilitate the integration of the Client SDK in Spring Boot applications -->
        <module>poc-tdk-settings-sdk-client-spring-boot-starter</module>

        <!-- Example Spring WebFlux application that uses the Client SDK -->
        <module>settings-webflux-app-example</module>
    </modules>

    <!-- Centralized dependency versions -->
    <dependencyManagement>
        <dependencies>
            <!-- Example managed dependency -->
            <!--
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-api</artifactId>
                <version>2.0.13</version>
            </dependency>
            -->
        </dependencies>
    </dependencyManagement>

    <!-- Centralized plugin versions -->
    <build>
        <pluginManagement>
            <plugins>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                    </configuration>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.2</version>
                </plugin>

            </plugins>
        </pluginManagement>
    </build>

</project>
